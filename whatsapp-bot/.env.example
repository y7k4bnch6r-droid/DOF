# Copia a .env para correr local con `npm start` (functions-framework lee el entorno del shell:
# `set -a; source .env; set +a; npm start`). En producción usa Secret Manager (ver README).

# --- Meta / WhatsApp Cloud API (App Dashboard → WhatsApp → API Setup) ---
WHATSAPP_TOKEN=                # token permanente del usuario de sistema
WHATSAPP_APP_SECRET=           # App Dashboard → App settings → Basic → App secret (firma los webhooks)
WHATSAPP_PHONE_NUMBER_ID=      # Phone number ID (no el número)
WHATSAPP_VERIFY_TOKEN=         # cadena aleatoria larga; la misma que pones al registrar el webhook
GRAPH_API_VERSION=v23.0        # revisa https://developers.facebook.com/docs/graph-api/changelog

# --- Consultorio ---
DOCTOR_PHONE=5215512345678     # número personal del doctor, formato internacional sin "+"
NOMBRE_DOCTOR=Dr. Ulises Pérez
CLINIC_ADDRESS=Av. Río Mixcoac 25, 8.º piso, consultorio 9, Col. Crédito Constructor (entre Barranca del Muerto e Insurgentes Sur)
PRICE_HOME=1700
PRICE_OFFICE=1200

# --- Horario nocturno (hora de la Ciudad de México, 0-23) ---
NIGHT_START_HOUR=22
NIGHT_END_HOUR=6

# --- Comportamiento ---
REPLY_COOLDOWN_MINUTES=240     # no repetir la misma respuesta automática al mismo contacto antes de este tiempo
LOG_RETENTION_DAYS=90          # los logs llevan expiraEn; activa TTL en Firestore para que se borren solos
LOG_MESSAGE_TEXT=false         # true guarda el texto del mensaje en logs (datos de salud: mejor no)
ALERT_DOCTOR=true              # avisar al doctor cuando un mensaje parece urgente
ALERT_TEMPLATE_NAME=           # plantilla aprobada para avisar fuera de la ventana de 24 h (opcional)
PRIVACY_NOTICE_URL=            # si se pone, la bienvenida termina con el enlace al aviso de privacidad
